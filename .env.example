# Local development configuration. Do not put credentials in this file.
DATA_PATH=data/ai4i2020.csv
MODEL_PATH=models/latest_model
MODEL_SOURCE=local
MODEL_VERSION=ai4i-base1
MODEL_NAME=MachSenseFailureClassifier
